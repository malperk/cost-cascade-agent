OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=omniroute-local

LOW_MODEL=alper-low
MID_MODEL=alper-mid
HIGH_MODEL=alper-high
LOCAL_MODEL=alper-local

MAX_ATTEMPTS=4

# Optional: consistent triage via TypeSafe's Jev (https://console.typesafe.ai). With a key set,
# short tasks are triaged by Jev; anything uncertain or failing falls back to the LLM triage.
# TRIAGE_BACKEND=llm turns Jev off even when a key is present.
TYPESAFE_API_KEY=
TRIAGE_BACKEND=auto
JEV_CONFIDENCE=0.7

# LangSmith tracing (optional) - get an API key at https://smith.langchain.com
# LangChain reads these directly from the environment, no code changes needed.
# Use https://eu.api.smith.langchain.com instead if your LangSmith org is on the EU region
# (check Settings in the LangSmith dashboard) - a US/EU mismatch causes 403 Forbidden.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-cost-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Browser tools (browser_open / browser_act / browser_text, headless Chromium via Playwright).
# BROWSER_ENABLED=false removes them. BROWSER_DECISIONS=auto lets Jev pick the element for
# browser_act (fast; falls back to the LLM when unsure) - it then sees the instruction, the page
# URL without query/fragment and visible element labels, so keep it "llm" for private pages.
BROWSER_ENABLED=true
BROWSER_DECISIONS=llm

# MCP server for other machines (python -m agent.server). Token is required, generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the LAN IP (or 0.0.0.0) as HOST so Hermes on another computer can reach it.
AGENT_SERVER_HOST=127.0.0.1
AGENT_SERVER_PORT=8765
AGENT_SERVER_TOKEN=

# Completion email for tasks submitted with notify=true. Recipient is fixed here.
# Gmail: smtp.gmail.com / 587 with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
